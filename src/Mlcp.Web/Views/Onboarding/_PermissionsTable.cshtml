@* The core registration's permissions, named as Microsoft's consent screen names them (ADR-015). *@
<table class="table align-middle">
    <thead>
        <tr>
            <th scope="col">Permission</th>
            <th scope="col">What we use it for</th>
            <th scope="col">What it does not do</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>Read organization information</td>
            <td>Your purchased licences, subscription renewal dates and verified domains</td>
            <td>Nothing about individual users</td>
        </tr>
        <tr>
            <td>Read all users' full profiles</td>
            <td>Which licences are assigned to which people, and whether accounts are active</td>
            <td>Cannot read email, files, messages or passwords; cannot change anything</td>
        </tr>
    </tbody>
</table>
