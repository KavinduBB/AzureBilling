@model Mlcp.Web.Models.NotConnectedViewModel
@{
    ViewData["Title"] = "Connect your organisation";
    var sentTo = TempData["ConsentRequestSentTo"] as string ?? Model.PendingRequestSentTo;
}

<h1>Connect your organisation</h1>

<p class="lead">
    Hello @Model.DisplayName. You are signed in, but your organisation is not connected to MLCP
    yet. Connecting takes a Global Administrator or Privileged Role Administrator about a minute.
</p>

<partial name="_Message" />

@if (sentTo is not null)
{
    <div class="alert alert-info" role="status">
        <strong>Request sent.</strong> We have emailed <strong>@sentTo</strong> a link explaining
        what we are asking for.
        @if (Model.PendingRequestExpiresUtc is { } expires)
        {
            <text>The link works until @expires.ToString("d MMMM yyyy").</text>
        }
    </div>
}

<div class="row g-4 mt-2">
    @if (Model.IsDirectoryAdmin)
    {
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">Connect as administrator</h2>
                    <p class="card-text">
                        You will see exactly which permissions we ask for on Microsoft's consent
                        screen before you accept, and you can revoke them at any time.
                    </p>
                    <partial name="_ConnectForm" model="Model.Region" />
                </div>
            </div>
        </div>
    }

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Ask my administrator</h2>
                <p class="card-text">
                    @if (!Model.IsDirectoryAdmin)
                    {
                        <text>Connecting needs a Global Administrator or Privileged Role Administrator.</text>
                    }
                    We will email them a link to a page explaining the request. Nothing happens
                    until they accept. The address must be in one of your organisation's domains.
                </p>

                <form asp-action="RequestConsent" method="post" class="row g-2">
                    <div class="col-12">
                        <label for="adminEmail" class="form-label">Administrator email</label>
                        <input type="email" class="form-control" id="adminEmail" name="adminEmail"
                               required maxlength="254" autocomplete="email" placeholder="admin@@yourcompany.com" />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-outline-primary">
                            @(sentTo is null ? "Send request" : "Send again")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<h2 class="h5 mt-5">What we ask for, and what we cannot do</h2>

<partial name="_PermissionsTable" />

<p class="text-muted">
    We never buy, assign or remove licences with these permissions. Access can be revoked at any
    time from <strong>Entra admin centre &rarr; Enterprise applications &rarr; MLCP &rarr;
    Permissions</strong>.
</p>

<partial name="_Preview" />
