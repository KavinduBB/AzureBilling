@model Mlcp.Web.Models.DisconnectedViewModel
@{
    ViewData["Title"] = "Disconnected";
}

<h1>Your organisation is disconnected</h1>

<p class="lead">
    Synchronisation has stopped. We are no longer reading anything from your Microsoft tenant.
</p>

@if (Model.DeleteScheduledUtc is { } scheduled)
{
    <div class="alert alert-warning" role="status">
        All of your data will be permanently deleted on
        <strong>@scheduled.ToString("d MMMM yyyy")</strong>. Until then you can reconnect and pick
        up where you left off.
    </div>
}

<p class="text-muted">
    You should also remove MLCP from
    <strong>Entra admin centre &rarr; Enterprise applications</strong> to revoke the permissions
    themselves. Disconnecting here stops us using them; removing the application there withdraws
    them entirely.
</p>

<p>
    <a class="btn btn-outline-primary" asp-action="Index">Reconnect</a>
</p>
