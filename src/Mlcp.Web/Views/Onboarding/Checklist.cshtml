@using Mlcp.Domain.Capabilities
@using Mlcp.Domain.Tenancy
@model Mlcp.Web.Models.ChecklistViewModel
@{
    ViewData["Title"] = "Connection status";
    var checklist = Model.Checklist;

    static string GuideAnchor(RemediationGuide guide) => guide switch
    {
        RemediationGuide.ConnectOrganisation => "/guides/connect-organisation",
        RemediationGuide.AzureRbac => "/guides/azure-costs",
        RemediationGuide.BillingRole => "/guides/prices-and-invoices",
        RemediationGuide.UsageInsights => "/guides/usage-insights",
        RemediationGuide.PartnerManaged => "/guides/partner-managed",
        RemediationGuide.ManualPricing => "/prices",
        _ => string.Empty,
    };

    static string GuideCallToAction(RemediationGuide guide) => guide switch
    {
        RemediationGuide.AzureRbac => "How to assign the role",
        RemediationGuide.BillingRole => "How to grant billing access",
        RemediationGuide.UsageInsights => "Turn on usage insights",
        RemediationGuide.PartnerManaged => "What partner-managed means",
        RemediationGuide.ManualPricing => "Enter your prices",
        _ => "How to fix this",
    };

    static string AgreementLabel(AgreementType agreement) => agreement switch
    {
        AgreementType.Mca => "Microsoft Customer Agreement",
        AgreementType.Ea => "Enterprise Agreement",
        AgreementType.Mosa => "Microsoft Online Subscription Agreement",
        AgreementType.Mpa => "Microsoft Partner Agreement",
        AgreementType.CspManaged => "Managed by a partner",
        AgreementType.NotDiscovered => "Not yet determined",
        AgreementType.Undetermined => "Agreement not visible yet",
        _ => "Unrecognised",
    };
}

<h1>Connection status</h1>

<p class="lead">
    @checklist.CompletedCount of @checklist.Items.Count unlocked &middot;
    <span class="text-muted">@AgreementLabel(checklist.AgreementType)</span>
</p>

<partial name="_Message" />

@if (checklist.IsPartnerManaged)
{
    <div class="alert alert-secondary" role="note">
        Your Microsoft licences are sold to you by a partner. Microsoft does not expose what your
        partner charges you, so prices and invoices come from you or from your partner rather than
        from an API. Everything else works normally.
    </div>
}

<ol class="list-unstyled">
@foreach (var item in checklist.Items)
{
    var state = item.IsComplete ? "complete" : item.IsActionable ? "actionable" : "explained";

    <li class="card mb-3" data-state="@state">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                    <h2 class="h5 card-title mb-1">
                        @if (item.IsComplete)
                        {
                            <span class="badge text-bg-success me-2" aria-label="Unlocked">&check;</span>
                        }
                        else if (item.IsActionable)
                        {
                            <span class="badge text-bg-warning me-2" aria-label="Action needed">!</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary me-2" aria-label="Not available">&ndash;</span>
                        }
                        @item.Title
                    </h2>
                    <p class="card-text text-muted mb-2">@item.Unlocks</p>

                    @* Unavailable data is always an explained state, never a blank panel
                       (CLAUDE.md rule 9). *@
                    @if (!item.IsComplete && item.Detail is { Length: > 0 } detail)
                    {
                        <p class="card-text mb-0">@detail</p>
                    }
                </div>

                <div class="d-flex flex-column gap-2 align-items-end">
                    @if (!item.IsComplete && item.Guide != RemediationGuide.None)
                    {
                        <a class="btn @(item.IsActionable ? "btn-primary" : "btn-outline-secondary") text-nowrap"
                           href="@GuideAnchor(item.Guide)">@GuideCallToAction(item.Guide)</a>
                    }

                    @if (!item.IsComplete && item.Key == "usage-reports" && Model.IsDirectoryAdmin && Model.CanConnectUsageInsights)
                    {
                        @* Tier 2 is a separate registration with its own consent (ADR-015). *@
                        <form asp-action="ConnectUsageInsights" method="post">
                            <button type="submit" class="btn btn-outline-primary text-nowrap">Connect MLCP Usage Insights</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </li>
}
</ol>

@if (checklist.OffersManualPricing)
{
    <p>
        Prices not available from Microsoft for your agreement?
        <a href="/prices">Enter your seat prices yourself</a>.
    </p>
}

@if (checklist.Explanations.Count > 0)
{
    <h2 class="h6 text-muted mt-4">Why some things stay locked</h2>
    <p class="text-muted">
        The items marked with a dash cannot be unlocked by granting anything. They depend on the
        commercial agreement your organisation holds with Microsoft, not on permissions. Where
        that is the case we say so rather than sending you to a settings page that will not help.
    </p>
}

@if (Model.IsDirectoryAdmin)
{
    <hr class="mt-5" />

    <h2 class="h6">Disconnect</h2>
    <p class="text-muted">
        Disconnecting stops all synchronisation immediately and schedules your data for deletion
        30 days later. An administrator can reverse it at any point during those 30 days.
    </p>
    <a class="btn btn-outline-danger btn-sm" asp-action="ConfirmDisconnect">Disconnect this organisation&hellip;</a>
}
