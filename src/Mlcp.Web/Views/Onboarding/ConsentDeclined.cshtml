@model Mlcp.Web.Models.ConsentDeclinedViewModel
@{
    ViewData["Title"] = "Not connected";
}

<h1>Nothing was changed</h1>

<p class="lead">@(Model.Description ?? "Consent was not completed, so your organisation is not connected.")</p>

<p class="text-muted">
    No permissions were granted and no data has been read. You can start again whenever you are
    ready.
</p>

<p>
    <a class="btn btn-primary" asp-action="Index">Back to connect</a>
</p>

@* The raw code is shown for support to correlate against Entra sign-in logs. It is a Microsoft
   error identifier, not a secret. *@
<p class="text-muted small">Reference: @Model.Error</p>
