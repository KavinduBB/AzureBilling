@model Mlcp.Web.Models.ConsentLandingViewModel
@{
    ViewData["Title"] = "A colleague has asked you to connect your organisation";
}

<h1>Connect your organisation to MLCP</h1>

<p class="lead">
    <strong>@Model.RequestedByUpn</strong> has asked you to connect your organisation so your team
    can track Microsoft licences, usage and Azure spend.
</p>

<h2 class="h5">What we ask for</h2>

<partial name="_PermissionsTable" />

<p class="text-muted">
    You will see this list again on Microsoft's own consent screen before anything is granted, and
    you can revoke access at any time from
    <strong>Entra admin centre &rarr; Enterprise applications</strong>.
</p>

@if (Model.IsDirectoryAdmin)
{
    <partial name="_ConnectForm" model="Model.Region" />
}
else
{
    <div class="alert alert-warning" role="note">
        Connecting needs a <strong>Global Administrator</strong> or <strong>Privileged Role
        Administrator</strong>. You are signed in without either role, so please pass this request
        to someone who holds one. If you have just been given the role, sign out and in again.
    </div>
}

<p class="text-muted small mt-3">This request expires on @Model.ExpiresUtc.ToString("d MMMM yyyy").</p>
